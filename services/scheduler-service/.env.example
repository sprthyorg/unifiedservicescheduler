# Copy to .env for local runs. Unset APP_DATABASE_URL → in-memory store.
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_SEED_DEMO_DATA=true
# APP_DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/scheduler
APP_SLOT_GRANULARITY_MINUTES=15
APP_MIN_LEAD_TIME_MINUTES=60
APP_BOOKING_HORIZON_DAYS=90
APP_ALTERNATIVES_COUNT=3
